# Bakix na Raspberry Pi. Zkopíruj do /etc/systemd/system/ (viz DEPLOY.md).
# Kód: /home/voku/bakix-app, data: /var/lib/bakix (SQLite).
[Unit]
Description=Bakix (https://bakix.cz)
After=network-online.target
Wants=network-online.target

[Service]
User=svc-bakix
Group=svc-bakix
WorkingDirectory=/home/voku/bakix-app
EnvironmentFile=/etc/bakix/bakix.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Migrace databáze před každým startem (bez nové revize nic nedělá).
ExecStartPre=/home/voku/bakix-app/.venv/bin/flask --app wsgi db upgrade
# Jeden proces s vlákny: paměť na školní data, zámky pro obnovu tokenů i rate limit pak platí
# pro celý web. Víc workerů = potřeba Redis a sdílené cache, viz CLAUDE.md.
# Jen 127.0.0.1: ven mluví Caddy. Bez access logu: IP adresy se nikam neukládají.
ExecStart=/home/voku/bakix-app/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 60 --bind 127.0.0.1:9960 wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5

StateDirectory=bakix
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
