# Zkopíruj do .env (ten je v .gitignore) a uprav.

# development | production. `python app.py` bez nastavení běží ve vývojovém režimu,
# příkaz `flask …` a gunicorn mají výchozí production.
BAKIX_ENV=development

# Server pro `python app.py`: kde poslouchat a kolik vláken (produkce).
# Za Caddy/nginx nech 127.0.0.1; 0.0.0.0 otevře port do sítě.
HOST=127.0.0.1
PORT=5000
THREADS=8

# Barevná paleta: voku | inkoust | tabule | grafit | svestka (náhled na /styleguide).
BAKIX_PALETTE=voku
# Tvary: kulaty (zaoblené panely i ovládání) | mix (hranatý rám, kulaté ovládání) | hranaty.
BAKIX_SHAPE=kulaty

# V produkci povinné. Vygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Klíč, kterým se šifrují tokeny Bakalářů v databázi. V produkci povinný a jiný než SECRET_KEY.
# Vygeneruj: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotace: NOVY,STARY → flask --app wsgi rotate-keys → nech jen NOVY.
CREDENTIALS_KEY=

# Bez nastavení se lokálně použije SQLite v instance/bakix_dev.db.
# Produkce na Pi: sqlite:////var/lib/bakix/bakix.db (viz DEPLOY.md).
DATABASE_URL=

# Veřejná adresa webu pro canonical, sitemap a Open Graph (nikdy se nebere z hlavičky Host).
PUBLIC_URL=

# Počet proxy před aplikací (Caddy = 1, lokálně 0).
PROXY_COUNT=

# Správce osobních údajů, ukáže se na /soukromi a /podminky. V produkci povinné.
PRIVACY_CONTROLLER=
PRIVACY_CONTACT_EMAIL=

# Školy, které chybí v oficiálním seznamu: "Název|Město|https://adresa", oddělené čárkou.
BAKALARI_EXTRA_SCHOOLS=

# Úložiště pro rate limit. Bez nastavení v paměti procesu (stačí pro 1 worker).
REDIS_URL=

# AI (volitelné; OpenAI-kompatibilní API, stejné proměnné jako Knowix).
# Bez klíče Bakix jen skládá zadání ke zkopírování a nikam nic neposílá.
AI_API_KEY=
AI_BASE_URL=https://api.aimlapi.com/v1
AI_MODEL=gpt-4o-mini
AI_DAILY_REQUESTS_PER_USER=10
AI_DAILY_REQUESTS_TOTAL=500

# Odkazy na sesterský Knowix. Prázdná hodnota je vypne.
KNOWIX_URL=https://knowix.cz
